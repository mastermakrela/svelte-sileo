{
  "name": "svelte-sileo",
  "version": "1.1.0",
  "description": "An opinionated, physics-based toast component for Svelte. Port of sileo.",
  "license": "MIT",
  "author": "Alexis Garcia <gvrciary@gmail.com>",
  "homepage": "https://svelte-sileo.gvrciary.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gvrciary/svelte-sileo.git"
  },
  "bugs": "https://github.com/gvrciary/svelte-sileo/issues",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package",
    "prepublishOnly": "npm run package",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22",
    "globals": "17.13.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "sugar-high": "2.5.1",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "keywords": [
    "svelte",
    "sileo",
    "toast",
    "sonner",
    "notification"
  ],
  "sideEffects": false,
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
